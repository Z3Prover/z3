(declare-const x String)
(declare-const y String)
(declare-const r String)
(declare-const s String)
(declare-const m Int)
(declare-const n Int)
(declare-const k Int)
(assert (= (str.++ (seq.power y m) (seq.power x m) r s) (str.++ "a" (seq.power x n) (seq.power (str.++ x "ab") k))))
(assert (>= m 0))
(assert (>= n 3))
(assert (>= k 2))
(assert (>= (str.len x) 3))
(check-sat)
