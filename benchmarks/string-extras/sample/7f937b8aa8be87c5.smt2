(declare-const x String)
(declare-const y String)
(declare-const r String)
(declare-const s String)
(declare-const m Int)
(declare-const n Int)
(declare-const k Int)
(assert (= (str.++ (seq.power (str.++ y x) 2) (seq.power "aab" 3) "a") (str.++ (seq.power "abaab" m) (seq.power "b" 3) "b" r)))
(assert (>= m 1))
(assert (>= n 0))
(assert (>= k 1))
(assert (not (= (str.++ x y) (str.++ y x))))
(assert (>= (str.len x) 1))
(check-sat)
