(declare-const x String)
(declare-const y String)
(declare-const r String)
(declare-const s String)
(declare-const m Int)
(declare-const n Int)
(declare-const k Int)
(assert (= (str.++ (seq.power "a" m) s "b") (str.++ "a" (seq.power y n))))
(assert (>= m 0))
(assert (>= n 2))
(assert (>= k 3))
(assert (not (= (str.++ x y) (str.++ y x))))
(assert (>= (str.len x) 2))
(check-sat)
