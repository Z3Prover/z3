(declare-const x String)
(declare-const y String)
(declare-const r String)
(declare-const s String)
(declare-const m Int)
(declare-const n Int)
(declare-const k Int)
(assert (= (seq.power x m) (str.++ (seq.power x n) s "a")))
(assert (>= m 1))
(assert (>= n 2))
(assert (>= k 3))
(assert (not (= (str.++ x y) (str.++ y x))))
(check-sat)
