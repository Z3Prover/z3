(declare-const x String)
(declare-const y String)
(declare-const r String)
(declare-const s String)
(declare-const m Int)
(declare-const n Int)
(declare-const k Int)
(assert (= (str.++ (seq.power x 2) "a" r) (str.++ "b" (seq.power (str.++ y x) n) (seq.power "a" m))))
(assert (>= m 0))
(assert (>= n 2))
(assert (>= k 1))
(assert (>= (str.len x) 1))
(check-sat)
