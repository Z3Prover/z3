+from pathlib import Path
+import re, json
+cpp = Path('src/nlsat/nlsat_clause.cpp').read_text(encoding='utf-8')
+hdr = Path('src/nlsat/nlsat_clause.h').read_text(encoding='utf-8')
+assert 'unsigned         m_var_hash;' in hdr and 'set_var_hash' in hdr
+bodies = re.findall(r'bool clause::contains\([^)]*\) const \{(.+?)\n    \}', cpp, re.S)
+assert len(bodies) == 2
+for b in bodies:
+    assert 'for (unsigned i = 0; i < m_size; ++i)' in b
+    assert 'm_var_hash' not in b and 'var_hash' not in b
+print(json.dumps({'contains_overloads': len(bodies), 'contains_uses_var_hash': False}))
