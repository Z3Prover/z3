index 000000000..7ea61313e
--- /dev/null
+++ b/dream_experiments/c2-t03-sexpr-has-location-helper.py
@@ -0,0 +1,8 @@
+from pathlib import Path
+import json
+text = Path('src/util/sexpr.h').read_text(encoding='utf-8')
+assert 'bool has_location() const' in text
+assert 'm_line != UINT_MAX && m_pos != UINT_MAX' in text
+mk_lines = [ln.strip() for ln in text.splitlines() if 'sexpr * mk_' in ln]
+assert len(mk_lines) == 7 and all('line = UINT_MAX' in ln and 'pos = UINT_MAX' in ln for ln in mk_lines)
+print(json.dumps({'has_location_header_only': True, 'factory_defaults_preserved': len(mk_lines)}))
