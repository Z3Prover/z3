@@ -0,0 +1,9 @@
+from pathlib import Path
+import re, json
+text = Path('src/parsers/smt2/smt2scanner.cpp').read_text(encoding='utf-8')
+body = re.search(r'void scanner::read_multiline_comment\(\) \{(.+?)\n    \}', text, re.S).group(1)
+assert "if (c == '|' && curr() == '#')" in body
+assert 'depth' not in body and 'nest' not in body.lower()
+assert "if (c == '\\n')" in body and 'new_line();' in body
+sample = '#| outer #| inner |# tail |#'
+print(json.dumps({'first_close_index': sample.find('|#'), 'tracks_nesting': False, 'updates_newlines': True}))
