@@ -0,0 +1,11 @@
+from pathlib import Path
+import re, json
+text = Path('src/api/api_log.cpp').read_text(encoding='utf-8')
+body = re.search(r'std::ostream & operator<<\(std::ostream & out, ll_escaped const & d\) \{(.+?)\n\}', text, re.S).group(1)
+assert "out << '\\\\' << str;" in body
+assert "c == '<' || c == '>'" in body
+assert "c == '\"'" not in body and "c == '\\\\'" not in body
+allowed_space = "c == ' '" in body
+encoded = ''.join(ch if ch.isalnum() or ch in '~!@#$%^&*-_+.?/ <> ' else '\\' + f'{ord(ch):03d}' for ch in 'a"\\\n b')
+assert encoded == 'a\\034\\092\\010 b'
+print(json.dumps({'quote_backslash_newline_encoding': encoded, 'space_allowed_raw': allowed_space}))
