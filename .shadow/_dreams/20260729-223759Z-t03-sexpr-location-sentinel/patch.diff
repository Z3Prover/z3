+++ b/dream_experiments/t03-sexpr-location-sentinel.py
@@ -0,0 +1,9 @@
+from pathlib import Path
+import re, json
+text = Path('src/util/sexpr.h').read_text(encoding='utf-8')
+mk_lines = [ln.strip() for ln in text.splitlines() if 'sexpr * mk_' in ln]
+assert mk_lines and all('line = UINT_MAX' in ln and 'pos = UINT_MAX' in ln for ln in mk_lines)
+assert 'has_line' not in text and 'has_pos' not in text and 'has_location' not in text
+accessors = re.findall(r'unsigned get_(line|pos)\(\) const', text)
+assert set(accessors) == {'line','pos'}
+print(json.dumps({'constructors_with_sentinel_defaults': len(mk_lines), 'raw_accessors': sorted(accessors)}))
