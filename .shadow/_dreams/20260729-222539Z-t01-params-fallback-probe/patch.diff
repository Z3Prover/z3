+from pathlib import Path
+import re, json
+text = Path('src/util/params.cpp').read_text(encoding='utf-8')
+for typ in ['bool','unsigned','double','char const *','symbol']:
+    assert 'params_ref const & fallback' in text
+assert text.count('params_ref const & fallback') >= 10
+macro = re.search(r'#define GET_VALUE2\(MATCH_CODE, KIND\) \{(.+?)#define GET_SIMPLE_VALUE2', text, re.S).group(1)
+assert 'it->first == k && it->second.m_kind == KIND' in macro
+assert 'return fallback.get_bool(k, _default);' in text
+print(json.dumps({'fallback_overloads': text.count('params_ref const & fallback'), 'macro_kind_guard': True}))
