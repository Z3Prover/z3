+from pathlib import Path
+import re, json
+text = Path('src/math/lp/nla_throttle.cpp').read_text(encoding='utf-8')
+assert text.count('return insert_new_impl(sig);') >= 5
+assert 'normalize_sign(sign)' in text and 'pack_rational_sign(d_sign) << 24' in text
+impl = re.search(r'bool nla_throttle::insert_new_impl\(const signature& sig\) \{(.+?)\n\}', text, re.S).group(1)
+assert 'm_seen.contains(sig)' in impl
+assert 'm_stats.m_nla_throttled_lemmas++' in impl
+assert 'return true;' in impl and 'm_seen.insert(sig)' in impl and 'm_trail.push(insert_map(m_seen, sig))' in impl and 'return false;' in impl
+print(json.dumps({'overloads_call_insert_new_impl': text.count('return insert_new_impl(sig);'), 'seen_returns_throttle_true': True}))
