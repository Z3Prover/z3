+from pathlib import Path
+import re, json
+text = Path('src/opt/opt_context.cpp').read_text(encoding='utf-8')
+soft = re.search(r'unsigned context::scoped_state::add\(expr\* f, rational const& w, symbol const& id\) \{(.+?)\n    \}', text, re.S).group(1)
+obj = re.search(r'unsigned context::scoped_state::add\(app\* t, bool is_max\) \{(.+?)\n    \}', text, re.S).group(1)
+assert 'if (!m.is_bool(f))' in soft and 'throw default_exception("Soft constraint should be Boolean")' in soft
+assert 'if (!m_bv.is_bv(t) && !m_arith.is_int_real(t))' in obj
+assert 'throw default_exception("Objective must be bit-vector, integer or real")' in obj
+assert soft.index('if (!m.is_bool(f))') < soft.index('m_objectives.push_back')
+assert obj.index('if (!m_bv.is_bv') < obj.index('m_objectives.push_back')
+print(json.dumps({'soft_constraint_boolean_guard': True, 'objective_sort_guard': True}))
