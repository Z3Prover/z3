# Run as a script (cmake -P) by the custom command in src/cmd_context/CMakeLists.txt.
#
# Inputs:
#   HEADERS_FILE  file listing the REGISTRATION_HEADERS of every component, one per line
#   SRC_DIR       the source directory (src/)
#   OUTPUT        source file to generate
#
# Writes OUTPUT with an #include for every listed header (leaving its timestamp
# alone if the content is unchanged) and fails if some header under SRC_DIR uses
# Z3_ADD_TACTIC, Z3_ADD_PROBE or Z3_ADD_SIMPLIFIER but is not listed. OUTPUT also
# defines z3_link_registrations(), which tactic_manager.cpp calls so that static
# links of libz3 keep this object file.

cmake_minimum_required(VERSION 3.26)

file(STRINGS "${HEADERS_FILE}" listed)
list(REMOVE_ITEM listed "")
list(REMOVE_DUPLICATES listed)

set(registering_regex "^[ \t]*Z3_ADD_(TACTIC|PROBE|SIMPLIFIER)[ \t]*\\(")
file(GLOB_RECURSE all_headers "${SRC_DIR}/*.h")
set(missing "")
foreach(h IN LISTS all_headers)
  if (h IN_LIST listed)
    continue()
  endif()
  file(STRINGS "${h}" hit REGEX "${registering_regex}" LIMIT_COUNT 1)
  if (hit)
    file(RELATIVE_PATH rel "${SRC_DIR}" "${h}")
    list(APPEND missing "${rel}")
  endif()
endforeach()
if (missing)
  list(JOIN missing "\n  " missing_text)
  message(FATAL_ERROR
    "These headers use Z3_ADD_TACTIC/Z3_ADD_PROBE/Z3_ADD_SIMPLIFIER but are not "
    "listed in REGISTRATION_HEADERS of any z3_add_component():\n  ${missing_text}\n"
    "Without that, their registrations are dropped from static builds of libz3.")
endif()

set(content "// Generated by cmake/z3_generate_registrations.cmake. Do not edit.\n")
list(SORT listed)
foreach(h IN LISTS listed)
  file(RELATIVE_PATH rel "${SRC_DIR}" "${h}")
  string(APPEND content "#include \"${rel}\"\n")
endforeach()
string(APPEND content "\nvoid z3_link_registrations() {}\n")

file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT INPUT_MAY_BE_RECENT)
file(REMOVE "${OUTPUT}.tmp")
