; A native Boolean gate clause connects XOR rewriting to unit resolution.
(set-option :produce-proofs true)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const s Bool)
(assert (xor p q))
(assert (or p r))
(assert (or p (not r)))
(assert (or q s))
(assert (or q (not s)))
(check-sat)
(get-proof)
