(*
   Z3SortedRouteTests.fst

   Executable tests of the Sorted/datatype document check with the checked
   DAG guard (`Z3SortedRoute`, the opt-in `verified-dag-v1` mode on the
   Sorted route), each a function returning `true`, verified with the F* test
   modules and run natively through `Z3CherryTests.run` (the Cherry checker).
   The documents are whole proofs (original assertions, entries, root
   `false`) whose quantifier introductions are prepared the way the marshaler
   prepares them: the `Z3DagDocument` builders and `prepare_certificate`,
   recorded as the entry's companion (`companions_at`). Nothing here
   fabricates a `Z3DagDocument.prepared` by record syntax.

   A. The same document is pending by default and accepted by the route: a
      shared diamond over a long-named sort, whose certificate the default
      guard cannot afford (the default epsilon check is `Some 1`), accepted
      by the route with the verdict `Some 0`, and the single diagnosed check
      (`diagnose_document_epsilon_route`) has the same verdict and one report
      whose outcome is the guard's.
   B. No fallback: the same document without companions, with a clausal
      companion set, with a companion recorded under another index, or with
      the companion of another certificate stays pending with the reason
      (unprepared, or the root of the companion is not the node's
      conclusion), and the default guard never decides it.
   C. Negatives: a certificate with a forward premise id rejects the document
      on both routes; a false NNF claim (not (not p) ~ q) in a would-be
      refutation of satisfiable assertions is never certified by either
      route (pending, the replay's entry loop rejects the rule).
   D. Open dependent Skolem steps: the FStar.Nonempty query 2 node 92
      document (the open `sk` step typed at the scope [Term; Universe], its
      closure generated by the epsilon elaboration) is accepted by default
      and by the route, with the Skolem typing gate in the route's units.
   E. A closed document without a quantifier introduction is checked
      identically (`Some 0`, no report).
   F. A document of 20,000 entries is checked and diagnosed at the normal stack.
*)
module Z3SortedRouteTests

open Z3AstTheory
module S = Z3DatatypeSignature
module U = Z3UnifiedProof
module P = Z3ProofDocument
module NR = Z3NnfReplay
module NRC = Z3NnfReplayChecked
module NT = Z3NnfReplayCheckedTests
module SP = Z3SortedProof
module SRt = Z3SortedRoute
module DD = Z3DagDocument
module VD = Z3VerifiedDocument
module G = Z3CheckedGuard
module CT = Z3CheckedTerms
module I = Z3ProofIndex
module L = FStar.List.Tot
module R = Z3ResolutionProofTheory
module O = Z3ObservationalEquality

(* ---------------------------------------------------------------------- *)
(* Shapes                                                                   *)
(* ---------------------------------------------------------------------- *)

let empty_schema : S.schema = { S.sorts = []; S.cases = [] }

let entry (r:U.rule) (f:expr) (ids:list int) : P.entry = { P.rule = r; formula = f; premise_ids = ids }

let doc (assertions:list expr) (entries:list P.entry) (root:int) : P.document = {
  P.declarations = []; P.expressions = []; P.assertions = assertions; P.entries = entries; P.root = root;
}

(* The companion set the marshaler records for one quantifier introduction at
   entry `index`: the certificate prepared on a checked graph, recorded under
   `index`. *)
let companions_at (index:nat) (entries:list U.binder_entry) (root:int) : option (DD.prepared & DD.companions) =
  let c0 : NT.inst = { NT.ic = DD.with_budget DD.empty_cache NT.ample NT.ample; NT.next = 1 } in
  match NT.install_entries c0 entries [] with
  | Some (c1, raws) ->
    (match DD.prepare_certificate c1.NT.ic raws root index with
     | DD.Built (c2, p) ->
       Some (p, { DD.clausal = false; DD.final = Some c2; DD.marks = I.index_put I.Empty index (DD.Recorded (0, 0)) })
     | _ -> None)
  | None -> None

(* The graph builders' steps, for the hand-built quantified diamond. *)
type qop =
  | QBase : nid:nat -> name:string -> qop
  | QApp : nid:nat -> dnid:nat -> name:string -> tag:option decl_kind -> args:list nat -> range:nat -> qop
  | QVar : nid:nat -> n:nat -> sort:nat -> qop
  | QQuant : nid:nat -> k:quantifier_kind -> sorts:list nat -> body:nat -> qop

let run_qop (c:DD.ccache) (o:qop) : DD.step DD.ccache =
  match o with
  | QBase nid name -> DD.build_base_sort c nid name
  | QApp nid dnid name tag args range -> DD.build_app c nid dnid name tag [] args range
  | QVar nid n sort -> DD.build_var c nid n sort
  | QQuant nid k sorts body -> DD.build_quant c nid k sorts body

let rec run_qops (c:DD.ccache) (ops:list qop) : Tot (option DD.ccache) (decreases ops) =
  match ops with
  | [] -> Some c
  | o :: rest -> (match run_qop c o with DD.Built c1 -> run_qops c1 rest | _ -> None)

(* s_0 = #0, s_(i+1) = h(s_i, s_i): node 11 + i is s_i (node 11 is #0 : Term). *)
let rec chain_qops (i k:nat) (acc:list qop) : Tot (list qop) (decreases k - i) =
  if i >= k then L.rev acc
  else chain_qops (i + 1) k (QApp (12 + i) 21 "h" None [11 + i; 11 + i] 1 :: acc)

(* The NNF certificate over a shared diamond under a binder:
     B = P(s_k), refl (not B ~ not B), nnf-neg (not (exists x. B) ~ forall x. not B)
   (the shape of the corpus's quantified NNF steps, which the propositional and equality kernels cannot
   prove). The tree of B has 2^k leaves, its graph k + 1 nodes. The preparation is recorded under `index`. *)
let diamond_at (k:nat) (index:nat) : option (DD.prepared & DD.companions) =
  let ops =
    L.append [QBase 1 NT.native_name; QBase 2 "Bool"; QVar 11 0 1]
      (L.append (chain_qops 0 k [])
         [QApp 100 22 "P" None [11 + k] 2;
          QApp 101 23 "not" (Some Z3ValueTheory.op_not) [100] 2;
          QQuant 102 Exists_k [1] 100;
          QApp 103 23 "not" (Some Z3ValueTheory.op_not) [102] 2;
          QQuant 104 Forall_k [1] 101;
          QApp 105 24 "~" (Some Z3ValueTheory.op_oeq) [101; 101] 2;
          QApp 106 24 "~" (Some Z3ValueTheory.op_oeq) [103; 104] 2]) in
  match run_qops (DD.with_budget DD.empty_cache NT.ample NT.ample) ops with
  | Some c ->
    let raws = [NT.raw "refl" 105 [];
                { DD.raw_name = "nnf-neg"; DD.raw_formula = 106; DD.raw_premises = [0]; DD.raw_sorts = Some [1] }] in
    (match DD.prepare_certificate c raws 1 index with
     | DD.Built (c2, p) ->
       Some (p, { DD.clausal = false; DD.final = Some c2; DD.marks = I.index_put I.Empty index (DD.Recorded (0, 0)) })
     | _ -> None)
  | None -> None

(* The refutation around a certificate whose root claims `a ~ b` (observational equality of two Boolean
   formulas): the assertions a and not b, the certificate (entry 1), modus ponens for b (entry 2) and unit
   resolution of not b against b. *)
let refutation (c:U.binder_certificate) (a b:expr) : P.document =
  doc [a; NT.neg b]
      [entry U.Asserted a [];
       entry (U.QuantifierIntroduction c) (O.mk_oeq_expr a b) [];
       entry U.ObservationalMP b [0; 1];
       entry U.Asserted (NT.neg b) [];
       entry U.UnitResolution R.false_expr [3; 2]]
      4

let sides_of (c:U.binder_certificate) : option (expr & expr) =
  match NT.own_conclusion c with
  | Some (U.Observational a b) -> Some (a, b)
  | _ -> None

let verdict_of (d:VD.verified_diagnostic) : option nat = SP.diagnostic_result d.VD.diagnostic

let is_checked (r:VD.binder_report) : bool = match r.VD.report_outcome with G.BinderGuardChecked _ -> true | _ -> false
let is_unprepared (r:VD.binder_report) (w:DD.unprepared_reason) : bool =
  match r.VD.report_outcome, r.VD.report_unprepared with
  | G.BinderUnprepared, Some v -> v = w
  | _, _ -> false
let is_entries_failed (r:VD.binder_report) : bool = match r.VD.report_outcome with G.BinderEntriesFailed -> true | _ -> false

(* ---------------------------------------------------------------------- *)
(* A. Pending by default, accepted by the route                             *)
(* ---------------------------------------------------------------------- *)

let diamond_route_accepts () : bool =
  match diamond_at 10 1 with
  | Some (p, cs) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       (* the route reads the preparation recorded for entry 1, the quantifier introduction *)
       SP.check_document_epsilon empty_schema d = Some 1 &&
       SRt.check_document_epsilon_route cs empty_schema d = Some 0 &&
       (let r = SRt.diagnose_document_epsilon_route cs empty_schema d in
        verdict_of r = Some 0 &&
        (match r.VD.reports with
         | [one] -> is_checked one && one.VD.report_index = 1 && one.VD.report_graph = Some (0, 0)
         | _ -> false))
     | None -> false)
  | None -> false

(* ---------------------------------------------------------------------- *)
(* B. No fallback                                                           *)
(* ---------------------------------------------------------------------- *)

let no_fallback () : bool =
  match diamond_at 10 1, diamond_at 3 1, diamond_at 10 0 with
  | Some (p, cs), Some (_, other), Some (_, elsewhere) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       let pending (r:VD.verified_diagnostic) (check:VD.binder_report -> bool) : bool =
         verdict_of r = Some 1 && (match r.VD.reports with [one] -> check one | _ -> false) in
       (* no companions at all *)
       SRt.check_document_epsilon_route DD.no_companions empty_schema d = Some 1 &&
       pending (SRt.diagnose_document_epsilon_route DD.no_companions empty_schema d)
               (fun r -> is_unprepared r DD.UnpreparedAbsent) &&
       (* a clausal document has none *)
       pending (SRt.diagnose_document_epsilon_route ({ cs with DD.clausal = true }) empty_schema d)
               (fun r -> is_unprepared r DD.UnpreparedClausal) &&
       (* a companion recorded under another entry index *)
       pending (SRt.diagnose_document_epsilon_route elsewhere empty_schema d)
               (fun r -> is_unprepared r DD.UnpreparedAbsent) &&
       (* the companion of another certificate: its root is not the node's conclusion *)
       pending (SRt.diagnose_document_epsilon_route other empty_schema d) is_entries_failed &&
       (* and the default route's own verdict is unchanged by all of it *)
       SP.check_document_epsilon empty_schema d = Some 1
     | None -> false)
  | _, _, _ -> false

(* ---------------------------------------------------------------------- *)
(* C. Negatives                                                             *)
(* ---------------------------------------------------------------------- *)

let pa : expr = NT.pa
let qa : expr = NT.qa

(* A forward (here: self) premise id is a malformed certificate: its document is rejected by both routes. *)
let malformed_rejected () : bool =
  let entries = [NT.refl pa; NT.be "nnf-neg" (NT.oeq (NT.twice pa) pa) [1]] in
  match companions_at 1 entries 1 with
  | Some (p, cs) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       SP.check_document_epsilon empty_schema d = None &&
       SRt.check_document_epsilon_route cs empty_schema d = None &&
       verdict_of (SRt.diagnose_document_epsilon_route cs empty_schema d) = None
     | None -> false)
  | None -> false

(* A false claim (not (not p) ~ q) with a would-be refutation of satisfiable inputs: pending on both routes. *)
let false_claim_not_certified () : bool =
  let entries = [NT.refl pa; NT.be "nnf-neg" (NT.oeq (NT.twice pa) qa) [0]] in
  match companions_at 1 entries 1 with
  | Some (p, cs) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       let r = SRt.diagnose_document_epsilon_route cs empty_schema d in
       SP.check_document_epsilon empty_schema d = Some 1 &&
       SRt.check_document_epsilon_route cs empty_schema d = Some 1 &&
       verdict_of r = Some 1 &&
       (match r.VD.reports with [one] -> is_entries_failed one | _ -> false)
     | None -> false)
  | None -> false

(* The same small certificate replayed by both routes (a true claim): the verdicts agree, the report is the guard's. *)
let double_negation_agrees () : bool =
  let entries = [NT.refl pa; NT.be "nnf-neg" (NT.oeq (NT.twice pa) pa) [0]] in
  match companions_at 1 entries 1 with
  | Some (p, cs) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       SP.check_document_epsilon empty_schema d = Some 0 &&
       SRt.check_document_epsilon_route cs empty_schema d = Some 0 &&
       (match (SRt.diagnose_document_epsilon_route cs empty_schema d).VD.reports with
        | [one] -> is_checked one
        | _ -> false)
     | None -> false)
  | None -> false

(* A small quantified NNF step (the diamond at depth 0): the default guard affords it and replays it (the propositional and
   equality kernels cannot prove it), the route replays it by the DAG guard; without the preparation the route leaves it pending
   and the default guard that replays it does not decide it. *)
let small_quantified_agrees () : bool =
  match diamond_at 0 1 with
  | Some (p, cs) ->
    (match sides_of p.DD.pcert with
     | Some (a, b) ->
       let d = refutation p.DD.pcert a b in
       SP.check_document_epsilon empty_schema d = Some 0 &&
       SRt.check_document_epsilon_route cs empty_schema d = Some 0 &&
       (match (SRt.diagnose_document_epsilon_route cs empty_schema d).VD.reports with
        | [one] -> is_checked one
        | _ -> false) &&
       SRt.check_document_epsilon_route DD.no_companions empty_schema d = Some 1
     | None -> false)
  | None -> false

(* ---------------------------------------------------------------------- *)
(* D. An open dependent Skolem step                                         *)
(* ---------------------------------------------------------------------- *)

let u0 : expr = NT.const "u0" NT.universe
let t0 : expr = NT.const "t0" NT.term
let n_N0 : expr = NT.valid (App NT.nonempty_d [u0; t0])
let n_sk0 : expr = App NT.x2_1 [t0; u0]
let n_inst0 : expr = NT.mk_and [NT.ht NT.max_ifuel n_sk0 t0; NT.valid (App NT.tag_d [u0; t0; n_sk0])]
let n_fa0 : expr =
  NT.forall_ [NT.term] (NT.neg (NT.mk_and [NT.ht NT.max_ifuel (Var 0 NT.term) t0; NT.valid (App NT.tag_d [u0; t0; Var 0 NT.term])]))
let n_tbody0 : expr = NT.mk_and [NT.mk_or [NT.neg n_N0; n_inst0]; NT.mk_or [n_N0; n_fa0]]
let n_h : expr = NT.forall_ [NT.term] (NT.neg (NT.ht NT.max_ifuel (Var 0 NT.term) t0))

(* FStar.Nonempty query 2 node 92: the certificate is entry 1 of a whole refutation. *)
let n92_document : P.document =
  doc [NT.n_src; n_N0; n_h]
      [entry U.Asserted NT.n_src [];
       entry (U.QuantifierIntroduction (NT.cert NT.n92_entries 6)) (NT.oeq NT.n_src NT.n_tgt) [];
       entry U.ObservationalMP NT.n_tgt [0; 1];
       entry (U.QuantifierInstantiation [u0; t0]) (NT.mk_or [NT.neg NT.n_tgt; n_tbody0]) [];
       entry U.Asserted n_N0 [];
       entry U.Asserted n_h [];
       entry (U.QuantifierInstantiation [n_sk0]) (NT.mk_or [NT.neg n_h; NT.neg (NT.ht NT.max_ifuel n_sk0 t0)]) [];
       entry U.UnitResolution R.false_expr [3; 2; 4; 6; 5]]
      7

let open_skolem_document () : bool =
  match companions_at 1 NT.n92_entries 6 with
  | Some (_, cs) ->
    (* the plain route leaves the dependent step to the elaboration's closure, which both routes get *)
    SP.check_document_epsilon empty_schema n92_document = Some 0 &&
    SRt.check_document_epsilon_route cs empty_schema n92_document = Some 0 &&
    (let r = SRt.diagnose_document_epsilon_route cs empty_schema n92_document in
     verdict_of r = Some 0 &&
     (match r.VD.reports with [one] -> is_checked one && one.VD.report_index = 1 | _ -> false)) &&
    (* the same document without the companion is pending, with the reason *)
    (let r = SRt.diagnose_document_epsilon_route DD.no_companions empty_schema n92_document in
     verdict_of r = Some 1 &&
     (match r.VD.reports with [one] -> is_unprepared one DD.UnpreparedAbsent | _ -> false))
  | None -> false

(* ---------------------------------------------------------------------- *)
(* E. A document without a quantifier introduction                          *)
(* ---------------------------------------------------------------------- *)

let plain_document () : bool =
  let d = doc [pa; NT.neg pa]
              [entry U.Asserted pa []; entry U.Asserted (NT.neg pa) []; entry U.UnitResolution R.false_expr [1; 0]] 2 in
  SP.check_document_epsilon empty_schema d = Some 0 &&
  SRt.check_document_epsilon_route DD.no_companions empty_schema d = Some 0 &&
  (let r = SRt.diagnose_document_epsilon_route DD.no_companions empty_schema d in
   verdict_of r = Some 0 && r.VD.reports = [])

(* ---------------------------------------------------------------------- *)
(* F. A large document at the normal stack                                  *)
(* ---------------------------------------------------------------------- *)

let rec repeat_entries (count:nat) (e:P.entry) (entries:list P.entry) : Tot (list P.entry) (decreases count) =
  if count = 0 then entries else repeat_entries (count - 1) e (e :: entries)

(* The entry loops of the route (check and diagnosis) are self tail calls: 20,000 entries check, and are diagnosed, as the default's. *)
let large_document () : bool =
  let e = entry U.Asserted R.false_expr [] in
  let d = doc [R.false_expr] (repeat_entries 20000 e []) 19999 in
  SP.check_document_epsilon empty_schema d = Some 0 &&
  SRt.check_document_epsilon_route DD.no_companions empty_schema d = Some 0 &&
  (let r = SRt.diagnose_document_epsilon_route DD.no_companions empty_schema d in
   verdict_of r = Some 0 && r.VD.reports = [])

let run () : bool =
  diamond_route_accepts () &&
  no_fallback () &&
  malformed_rejected () &&
  false_claim_not_certified () &&
  double_negation_agrees () &&
  small_quantified_agrees () &&
  open_skolem_document () &&
  plain_document () &&
  large_document ()
