(*
   Z3ExtractedProof_Bv.fst -- AUTO-GENERATED by tools/extract_z3_proof.py

   This file is NOT hand-written: it is a literal transcription of a
   real proof object Z3 itself produced (via the Python front-end,
   `z3.Solver.proof()`) for the example recorded below, converted into
   `Z3ProofTheory.fst`'s `proof`/`Z3AstTheory.fst`'s `expr` syntax by
   `tools/extract_z3_proof.py`. Regenerate it by rerunning that script;
   do not hand-edit.

   Example: assertions from tools\test_bvand_self.smt2
*)
module Z3ExtractedProof_Bv
#lang-pulse
open Pulse.Lib.Pervasives
open Z3AstTheory
open Z3ValueTheory
open Z3ProofTheory
open Z3PulseProofChecker
open Z3InterpretedProofChecker
open Z3PatternMatchedProofChecker


let srt_0 : sort = BaseSort "Bool"
let srt_1 : sort = BaseSort "BV32"

let fd_0 : func_decl = { decl_name = "not"; domain = [srt_0]; range = srt_0; interp = Some op_not; int_params = [] }
let fd_1 : func_decl = { decl_name = "y"; domain = []; range = srt_1; interp = None; int_params = [] }
let fd_2 : func_decl = { decl_name = "bvand"; domain = [srt_1; srt_1]; range = srt_1; interp = Some op_bvand; int_params = [] }
let fd_3 : func_decl = { decl_name = "="; domain = [srt_1; srt_1]; range = srt_0; interp = Some op_eq; int_params = [] }
let fd_4 : func_decl = { decl_name = "true"; domain = []; range = srt_0; interp = None; int_params = [] }
let fd_5 : func_decl = { decl_name = "bvnot"; domain = [srt_1]; range = srt_1; interp = None; int_params = [] }
let fd_6 : func_decl = { decl_name = "bvor"; domain = [srt_1; srt_1]; range = srt_1; interp = None; int_params = [] }
let fd_7 : func_decl = { decl_name = "false"; domain = []; range = srt_0; interp = None; int_params = [] }

let e_0 : expr = App fd_1 []
let e_1 : expr = App fd_2 [e_0; e_0]
let e_2 : expr = App fd_3 [e_1; e_0]
let e_3 : expr = App fd_4 []
let e_4 : expr = App fd_5 [e_0]
let e_5 : expr = App fd_6 [e_4; e_4]
let e_6 : expr = App fd_5 [e_5]
let e_7 : expr = App fd_5 [e_4]
let e_8 : expr = App fd_3 [e_0; e_0]
let e_9 : expr = App fd_0 [e_3]
let e_10 : expr = App fd_7 []

let p_0 : proof = Rewrite e_1 e_6
let p_1 : proof = Rewrite e_5 e_4
let p_2 : proof = Congr fd_5 [e_5] [e_4] [p_1]
let p_3 : proof = Rewrite e_7 e_0
let p_4 : proof = Trans p_2 p_3
let p_5 : proof = Trans p_0 p_4
let p_6 : proof = Congr fd_3 [e_1; e_0] [e_0; e_0] [p_5]
let p_7 : proof = Rewrite e_8 e_3
let p_8 : proof = Trans p_6 p_7
let p_9 : proof = Congr fd_0 [e_2] [e_3] [p_8]
let p_10 : proof = Rewrite e_9 e_10
let p_11 : proof = Trans p_9 p_10

let extracted_proof : proof = p_11

(* The checker does not merely accept `extracted_proof` -- it computes
   its exact conclusion via `fact`, which we also print/assert here.
   Larger extracted proofs can need more SMT budget than F*'s
   defaults to unfold the structural `fact`/`congr_matched`
   recursion all the way down, so we bump both here. *)
#push-options "--z3rlimit 60 --fuel 4 --ifuel 4"
let lemma_extracted_proof_wellformed ()
  : Lemma (Some? (fact extracted_proof))
  = assert_norm (Some? (fact extracted_proof))

fn check_extracted ()
  requires emp
  ensures emp
{
  lemma_extracted_proof_wellformed ();
  let mut ctr = 0;
  let o = check_proof extracted_proof ctr;
  let n = !ctr;
  assert (pure (n == proof_size extracted_proof));
  assert (pure (Some? o));
  let ok = checker_accepts extracted_proof;
  assert (pure (ok == true));
}
#pop-options

(* Pattern-matching cross-check: `collect_unmatched` (already proven
   sound -- `lemma_partial_proof_true` in
   Z3PatternMatchedProofChecker.fst) is the trusted, independent
   source of truth for which `Rewrite` leaves of this extracted proof
   fit one of the six verified rewrite-rule schemas; `tools/
   extract_z3_proof.py` separately mirrors the same six matchers in
   Python purely to produce a human-readable log (see the
   --log output / *.unmatched.log). This assertion forces F* to
   recompute `collect_unmatched` on the *real* checker and confirms
   its leftover count agrees with the Python log's count -- if the
   Python mirror were ever wrong or out of sync with the verified
   matcher library, this assertion (not just the log) would fail to
   type-check. *)
#push-options "--z3rlimit 60 --fuel 4 --ifuel 4"
let lemma_unmatched_count_cross_checked ()
  : Lemma (FStar.List.Tot.length (collect_unmatched extracted_proof) == 5)
  = assert_norm (FStar.List.Tot.length (collect_unmatched extracted_proof) == 5)
#pop-options
