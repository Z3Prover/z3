(*
   Z3ExtractedProof_FromFile.fst -- AUTO-GENERATED by tools/extract_z3_proof.py

   This file is NOT hand-written: it is a literal transcription of a
   real proof object Z3 itself produced (via the Python front-end,
   `z3.Solver.proof()`) for the example recorded below, converted into
   `Z3ProofTheory.fst`'s `proof`/`Z3AstTheory.fst`'s `expr` syntax by
   `tools/extract_z3_proof.py`. Regenerate it by rerunning that script;
   do not hand-edit.

   Example: assertions from test_not_not.smt2
*)
module Z3ExtractedProof_FromFile
#lang-pulse
open Pulse.Lib.Pervasives
open Z3AstTheory
open Z3ProofTheory
open Z3PulseProofChecker


let srt_0 : sort = { sort_name = "Bool" }

let fd_0 : func_decl = { decl_name = "xor"; domain = [srt_0; srt_0]; range = srt_0; interp = None; int_params = [] }
let fd_1 : func_decl = { decl_name = "x"; domain = []; range = srt_0; interp = None; int_params = [] }
let fd_2 : func_decl = { decl_name = "not"; domain = [srt_0]; range = srt_0; interp = None; int_params = [] }
let fd_3 : func_decl = { decl_name = "false"; domain = []; range = srt_0; interp = None; int_params = [] }

let e_0 : expr = App fd_1 []
let e_1 : expr = App fd_2 [e_0]
let e_2 : expr = App fd_2 [e_1]
let e_3 : expr = App fd_0 [e_0; e_0]
let e_4 : expr = App fd_3 []

let p_0 : proof = Rewrite e_2 e_0
let p_1 : proof = Congr fd_0 [e_2; e_0] [e_0; e_0] [p_0]
let p_2 : proof = Rewrite e_3 e_4
let p_3 : proof = Trans p_1 p_2

let extracted_proof : proof = p_3

(* The checker does not merely accept `extracted_proof` -- it computes
   its exact conclusion via `fact`, which we also print/assert here. *)
let lemma_extracted_proof_wellformed ()
  : Lemma (Some? (fact extracted_proof))
  = ()

fn check_extracted ()
  requires emp
  ensures emp
{
  let ctr = Pulse.Lib.Reference.alloc 0;
  let o = check_proof extracted_proof ctr;
  let n = !ctr;
  Pulse.Lib.Reference.free ctr;
  assert (pure (n == proof_size extracted_proof));
  assert (pure (Some? o));
  let ok = checker_accepts extracted_proof;
  assert (pure (ok == true));
}
