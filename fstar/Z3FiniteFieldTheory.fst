module Z3FiniteFieldTheory

(*
   F* audit model for Z3's prime-field implementation:

     src/ast/ff_decl_plugin.cpp
     src/ast/rewriter/ff_rewriter.h
     src/ast/ff/ff_solver.cpp
     src/math/ff/ff_*.{h,cpp}
     src/smt/theory_ff.cpp
     src/tactic/ff/ff_*.cpp

   The C++ implementation represents elements by canonical integer residues,
   polynomials by sparse maps from sorted variable multisets to coefficients,
   and contradictions by deriving a nonzero constant (normalized to one) in
   the ideal generated by the input equations.  This file isolates the
   semantic obligations behind those representations and proves the
   transformations used by the rewriter, polynomial engine, completion
   procedures, theory plugin and tactics.

   The model is generic over a finite field.  The `finite_field` record makes
   every algebraic assumption explicit: field laws, absence of zero divisors,
   inverses for nonzero values, a complete enumeration, and Frobenius'
   x^q=x law.  For `(_ FiniteField p)`, `ff_decl_plugin` is responsible for
   establishing this contract.  Its Miller-Rabin test is deterministic for
   p < 2^64.  For larger p it is a fixed probable-prime screen, not a
   primality certificate; consequently the large-modulus C++ path has this
   contract as a trusted boundary.  No solver heuristic is modeled as an
   algebraic axiom.

   Buchberger/F4 scheduling, sparse/dense matrix layout, Montgomery
   representation, caches and resource limits are implementation refinements.
   Soundness depends only on the explicit ideal operations proved below.
   Exhaustion may therefore return unknown without weakening any theorem.
*)

open FStar.List.Tot

(* ----------------------------------------------------------------- *)
(* Explicit finite-field contract                                    *)
(* ----------------------------------------------------------------- *)

let rec pow_sem (#a:eqtype) (mul:a -> a -> a) (one:a) (x:a) (n:nat) : Tot a
  (decreases n)
= if n = 0 then one else mul x (pow_sem mul one x (n - 1))

noeq type finite_field (a:eqtype) = {
  zero: a;
  one: a;
  zero_ne_one: unit -> Lemma (zero <> one);
  add: a -> a -> a;
  mul: a -> a -> a;
  neg: a -> a;
  inv: a -> a;

  add_assoc: x:a -> y:a -> z:a ->
    Lemma (add x (add y z) == add (add x y) z);
  add_comm: x:a -> y:a -> Lemma (add x y == add y x);
  add_zero: x:a -> Lemma (add x zero == x);
  add_neg: x:a -> Lemma (add x (neg x) == zero);

  mul_assoc: x:a -> y:a -> z:a ->
    Lemma (mul x (mul y z) == mul (mul x y) z);
  mul_comm: x:a -> y:a -> Lemma (mul x y == mul y x);
  mul_one: x:a -> Lemma (mul x one == x);
  mul_zero: x:a -> Lemma (mul x zero == zero);
  left_distrib: x:a -> y:a -> z:a ->
    Lemma (mul x (add y z) == add (mul x y) (mul x z));

  inv_nonzero: x:a -> Lemma (requires x <> zero)
                            (ensures mul x (inv x) == one);
  no_zero_divisors: x:a -> y:a ->
    Lemma ((mul x y == zero) <==> (x == zero \/ y == zero));

  cardinality: pos;
  values: list a;
  values_complete: x:a -> Lemma (mem x values);
  frobenius: x:a -> Lemma (pow_sem mul one x cardinality == x)
}

let sub (#a:eqtype) (f:finite_field a) (x y:a) : a = f.add x (f.neg y)

let two (#a:eqtype) (f:finite_field a) : a = f.add f.one f.one

let pow (#a:eqtype) (f:finite_field a) (x:a) (n:nat) : a =
  pow_sem f.mul f.one x n

let lemma_add_zero_left (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (f.add f.zero x == x)
= f.add_comm f.zero x; f.add_zero x

let lemma_mul_one_left (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (f.mul f.one x == x)
= f.mul_comm f.one x; f.mul_one x

let lemma_mul_zero_left (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (f.mul f.zero x == f.zero)
= f.mul_comm f.zero x; f.mul_zero x

let lemma_neg_zero (#a:eqtype) (f:finite_field a)
  : Lemma (f.neg f.zero == f.zero)
= f.add_zero (f.neg f.zero);
  f.add_comm (f.neg f.zero) f.zero;
  f.add_neg f.zero

let lemma_add_left_cancel (#a:eqtype) (f:finite_field a) (x y z:a)
  : Lemma (requires f.add x y == f.add x z)
          (ensures y == z)
= f.add_comm x y;
  f.add_comm x z;
  f.add_assoc y x (f.neg x);
  f.add_assoc z x (f.neg x);
  f.add_neg x;
  f.add_zero y;
  f.add_zero z

let lemma_neg_unique (#a:eqtype) (f:finite_field a) (x y:a)
  : Lemma (requires f.add x y == f.zero)
          (ensures y == f.neg x)
= f.add_neg x;
  lemma_add_left_cancel f x y (f.neg x)

let lemma_neg_involutive (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (f.neg (f.neg x) == x)
= f.add_comm (f.neg x) x;
  f.add_neg x;
  lemma_neg_unique f (f.neg x) x

let lemma_neg_mul (#a:eqtype) (f:finite_field a) (x y:a)
  : Lemma (f.neg (f.mul x y) == f.mul (f.neg x) y)
= f.left_distrib y x (f.neg x);
  f.add_neg x;
  f.mul_zero y;
  f.mul_comm y x;
  f.mul_comm y (f.neg x);
  lemma_neg_unique f (f.mul x y) (f.mul (f.neg x) y)

let lemma_sub_self (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (sub f x x == f.zero)
= f.add_neg x

let lemma_sub_eq_zero (#a:eqtype) (f:finite_field a) (x y:a)
  : Lemma ((sub f x y == f.zero) <==> (x == y))
= if sub f x y == f.zero
   then (
     f.add_comm x (f.neg y);
     f.add_neg y;
     f.add_comm y (f.neg y);
     lemma_add_left_cancel f (f.neg y) x y
   )
   else if x = y then f.add_neg x else ()

(* ----------------------------------------------------------------- *)
(* Declaration and rewriter semantics                                *)
(* ----------------------------------------------------------------- *)

let rec bitsum (#a:eqtype) (f:finite_field a) (xs:list a) : Tot a
  (decreases xs)
= match xs with
   | [] -> f.zero
   | x :: tl -> f.add x (f.mul (two f) (bitsum f tl))

let lemma_bitsum_nil (#a:eqtype) (f:finite_field a)
  : Lemma (bitsum f [] == f.zero)
= ()

let lemma_bitsum_cons (#a:eqtype) (f:finite_field a) (x:a) (xs:list a)
  : Lemma (bitsum f (x :: xs) == f.add x (f.mul (two f) (bitsum f xs)))
= ()

let lemma_add_flatten (#a:eqtype) (f:finite_field a) (x y z:a)
  : Lemma (f.add x (f.add y z) == f.add (f.add x y) z)
= f.add_assoc x y z

let lemma_mul_flatten (#a:eqtype) (f:finite_field a) (x y z:a)
  : Lemma (f.mul x (f.mul y z) == f.mul (f.mul x y) z)
= f.mul_assoc x y z

let lemma_combine_coefficients (#a:eqtype) (f:finite_field a) (c d m:a)
  : Lemma (f.add (f.mul c m) (f.mul d m) == f.mul (f.add c d) m)
= f.left_distrib m c d;
  f.mul_comm m c;
  f.mul_comm m d;
  f.mul_comm m (f.add c d)

let lemma_mul_left_cancel (#a:eqtype) (f:finite_field a) (c x y:a)
  : Lemma (requires c <> f.zero /\ f.mul c x == f.mul c y)
          (ensures x == y)
= f.inv_nonzero c;
  f.mul_comm c (f.inv c);
  f.mul_assoc (f.inv c) c x;
  f.mul_assoc (f.inv c) c y;
  lemma_mul_one_left f x;
  lemma_mul_one_left f y

let lemma_affine_solve (#a:eqtype) (f:finite_field a) (c x r:a)
  : Lemma (requires c <> f.zero)
          (ensures (f.add (f.mul c x) r == f.zero) <==>
                   (x == f.mul (f.neg r) (f.inv c)))
= f.inv_nonzero c;
  f.mul_comm c (f.inv c);
  f.mul_assoc c (f.neg r) (f.inv c);
  f.mul_assoc (f.neg r) c (f.inv c);
  f.mul_comm c (f.neg r);
  f.mul_one (f.neg r);
  if f.add (f.mul c x) r == f.zero
  then (
    f.add_comm (f.mul c x) r;
    lemma_neg_unique f r (f.mul c x);
    lemma_mul_left_cancel f c x (f.mul (f.neg r) (f.inv c))
  )
  else if x == f.mul (f.neg r) (f.inv c)
  then (
    f.add_comm (f.neg r) r;
    f.add_neg r
  )
  else ()

let lemma_product_zero (#a:eqtype) (f:finite_field a) (x y:a)
  : Lemma ((f.mul x y == f.zero) <==> (x == f.zero \/ y == f.zero))
= f.no_zero_divisors x y

let lemma_disjunction_as_product (#a:eqtype) (f:finite_field a) (a0 a1 b0 b1:a)
  : Lemma (((a0 == a1) \/ (b0 == b1)) <==>
           (f.mul (sub f a0 a1) (sub f b0 b1) == f.zero))
= f.no_zero_divisors (sub f a0 a1) (sub f b0 b1);
  lemma_sub_eq_zero f a0 a1;
  lemma_sub_eq_zero f b0 b1

let is_boolean (#a:eqtype) (f:finite_field a) (x:a) : prop =
  f.mul x x == x

let lemma_mul_neg_one (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (f.mul x (f.neg f.one) == f.neg x)
= lemma_neg_mul f f.one x;
  lemma_mul_one_left f x;
  f.mul_comm (f.neg f.one) x

let lemma_boolean_factor (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (is_boolean f x <==>
           f.mul x (sub f x f.one) == f.zero)
= f.left_distrib x x (f.neg f.one);
  lemma_mul_neg_one f x;
  lemma_sub_eq_zero f (f.mul x x) x

let lemma_boolean_split (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (is_boolean f x <==> (x == f.zero \/ x == f.one))
= lemma_boolean_factor f x;
  f.no_zero_divisors x (sub f x f.one);
  lemma_sub_eq_zero f x f.one;
  ()

let lemma_zero_indicator (#a:eqtype) (f:finite_field a) (x z u c:a)
  : Lemma (requires f.mul x z == f.zero /\
                    z == f.add f.one (f.mul c (f.mul x u)))
          (ensures z == (if x == f.zero then f.one else f.zero))
= if x == f.zero
   then (
     lemma_mul_zero_left f u;
     f.mul_zero c;
     f.add_zero f.one
   )
   else (
     f.no_zero_divisors x z
   )

let lemma_nonzero_indicator (#a:eqtype) (f:finite_field a) (x z u c:a)
  : Lemma (requires f.mul x (sub f f.one z) == f.zero /\
                    z == f.mul c (f.mul x u))
          (ensures z == (if x == f.zero then f.zero else f.one))
= if x == f.zero
   then (
     lemma_mul_zero_left f u;
     f.mul_zero c
   )
   else (
     f.no_zero_divisors x (sub f f.one z);
     lemma_sub_eq_zero f f.one z
   )

(* ----------------------------------------------------------------- *)
(* Sparse polynomial semantics                                       *)
(* ----------------------------------------------------------------- *)

type variable = nat
type monomial = list variable
type env (a:Type) = variable -> a
type term (a:Type) = monomial & a
type polynomial (a:Type) = list (term a)

let rec eval_monomial (#a:eqtype) (f:finite_field a) (rho:env a) (m:monomial)
  : Tot a (decreases m)
= match m with
   | [] -> f.one
   | v :: tl -> f.mul (rho v) (eval_monomial f rho tl)

let rec eval_poly (#a:eqtype) (f:finite_field a) (rho:env a) (p:polynomial a)
  : Tot a (decreases p)
= match p with
   | [] -> f.zero
   | (m, c) :: tl ->
     f.add (f.mul c (eval_monomial f rho m)) (eval_poly f rho tl)

let rec scale_poly (#a:eqtype) (f:finite_field a) (c:a) (p:polynomial a)
  : Tot (polynomial a) (decreases p)
= match p with
   | [] -> []
   | (m, d) :: tl -> (m, f.mul c d) :: scale_poly f c tl

let add_poly (#a:eqtype) (_:finite_field a) (p q:polynomial a)
  : polynomial a
= append p q

let rec mul_monomial (m:monomial) (#a:Type) (p:polynomial a)
  : Tot (polynomial a) (decreases p)
= match p with
   | [] -> []
   | (n, c) :: tl -> (append m n, c) :: mul_monomial m tl

let rec mul_poly (#a:eqtype) (f:finite_field a) (p q:polynomial a)
  : Tot (polynomial a) (decreases p)
= match p with
   | [] -> []
   | (m, c) :: tl ->
     add_poly f (scale_poly f c (mul_monomial m q)) (mul_poly f tl q)

let rec lemma_eval_monomial_append (#a:eqtype) (f:finite_field a) (rho:env a)
    (m n:monomial)
  : Lemma (eval_monomial f rho (append m n) ==
           f.mul (eval_monomial f rho m) (eval_monomial f rho n))
          (decreases m)
= match m with
   | [] -> lemma_mul_one_left f (eval_monomial f rho n)
   | _ :: tl ->
     lemma_eval_monomial_append f rho tl n;
     f.mul_assoc (rho (hd m)) (eval_monomial f rho tl)
                 (eval_monomial f rho n)

let rec lemma_eval_append (#a:eqtype) (f:finite_field a) (rho:env a)
    (p q:polynomial a)
  : Lemma (eval_poly f rho (append p q) ==
           f.add (eval_poly f rho p) (eval_poly f rho q))
          (decreases p)
= match p with
   | [] -> lemma_add_zero_left f (eval_poly f rho q)
   | _ :: tl ->
     lemma_eval_append f rho tl q;
     f.add_assoc (f.mul (snd (hd p)) (eval_monomial f rho (fst (hd p))))
                 (eval_poly f rho tl) (eval_poly f rho q)

let rec lemma_eval_scale (#a:eqtype) (f:finite_field a) (rho:env a)
    (c:a) (p:polynomial a)
  : Lemma (eval_poly f rho (scale_poly f c p) ==
           f.mul c (eval_poly f rho p))
          (decreases p)
= match p with
   | [] -> f.mul_zero c
   | (m, d) :: tl ->
     lemma_eval_scale f rho c tl;
     f.left_distrib c (f.mul d (eval_monomial f rho m))
                       (eval_poly f rho tl);
     f.mul_assoc c d (eval_monomial f rho m)

let rec lemma_eval_mul_monomial (#a:eqtype) (f:finite_field a) (rho:env a)
    (m:monomial) (p:polynomial a)
  : Lemma (eval_poly f rho (mul_monomial m p) ==
           f.mul (eval_monomial f rho m) (eval_poly f rho p))
          (decreases p)
= match p with
   | [] -> f.mul_zero (eval_monomial f rho m)
   | (n, c) :: tl ->
     lemma_eval_monomial_append f rho m n;
     lemma_eval_mul_monomial f rho m tl;
     f.left_distrib (eval_monomial f rho m)
                    (f.mul c (eval_monomial f rho n))
                    (eval_poly f rho tl);
     f.mul_assoc (eval_monomial f rho m) c (eval_monomial f rho n);
     f.mul_assoc c (eval_monomial f rho m) (eval_monomial f rho n);
     f.mul_comm c (eval_monomial f rho m)

let rec lemma_eval_mul (#a:eqtype) (f:finite_field a) (rho:env a)
    (p q:polynomial a)
  : Lemma (eval_poly f rho (mul_poly f p q) ==
           f.mul (eval_poly f rho p) (eval_poly f rho q))
          (decreases p)
= match p with
   | [] -> lemma_mul_zero_left f (eval_poly f rho q)
   | (m, c) :: tl ->
     lemma_eval_append f rho
       (scale_poly f c (mul_monomial m q)) (mul_poly f tl q);
     lemma_eval_scale f rho c (mul_monomial m q);
     lemma_eval_mul_monomial f rho m q;
     lemma_eval_mul f rho tl q;
     f.mul_assoc c (eval_monomial f rho m) (eval_poly f rho q);
     f.left_distrib (eval_poly f rho q)
                    (f.mul c (eval_monomial f rho m))
                    (eval_poly f rho tl);
     f.mul_comm
       (f.add (f.mul c (eval_monomial f rho m)) (eval_poly f rho tl))
       (eval_poly f rho q);
     f.mul_comm (eval_poly f rho q) (f.mul c (eval_monomial f rho m));
     f.mul_comm (eval_poly f rho q) (eval_poly f rho tl);
     ()

(* A scalar reduction step is f' = f + c*m*g.  If g is a basis equation,
   the old and new rows have identical values on every common zero. *)
let reduction_step (#a:eqtype) (f:finite_field a)
    (row reducer:polynomial a) (c:a) (m:monomial)
  : polynomial a
= add_poly f row (scale_poly f c (mul_monomial m reducer))

let lemma_reduction_preserves_zero (#a:eqtype) (f:finite_field a) (rho:env a)
    (row reducer:polynomial a) (c:a) (m:monomial)
  : Lemma (requires eval_poly f rho reducer == f.zero)
          (ensures eval_poly f rho (reduction_step f row reducer c m) ==
                   eval_poly f rho row)
= lemma_eval_append f rho row (scale_poly f c (mul_monomial m reducer));
  lemma_eval_scale f rho c (mul_monomial m reducer);
  lemma_eval_mul_monomial f rho m reducer;
  f.mul_zero (eval_monomial f rho m);
  f.mul_zero c;
  f.add_zero (eval_poly f rho row)

(* S-polynomials are a difference of monomial multiples.  The concrete
   engine chooses multipliers that cancel leading terms; cancellation is a
   progress property, while ideal membership follows from this lemma alone. *)
let s_polynomial (#a:eqtype) (f:finite_field a)
    (p q:polynomial a) (cp cq:a) (mp mq:monomial)
  : polynomial a
= add_poly f
     (scale_poly f cp (mul_monomial mp p))
     (scale_poly f (f.neg cq) (mul_monomial mq q))

let lemma_s_polynomial_vanishes (#a:eqtype) (f:finite_field a) (rho:env a)
    (p q:polynomial a) (cp cq:a) (mp mq:monomial)
  : Lemma (requires eval_poly f rho p == f.zero /\
                    eval_poly f rho q == f.zero)
          (ensures eval_poly f rho (s_polynomial f p q cp cq mp mq) ==
                   f.zero)
= lemma_eval_append f rho
     (scale_poly f cp (mul_monomial mp p))
     (scale_poly f (f.neg cq) (mul_monomial mq q));
  lemma_eval_scale f rho cp (mul_monomial mp p);
  lemma_eval_scale f rho (f.neg cq) (mul_monomial mq q);
  lemma_eval_mul_monomial f rho mp p;
  lemma_eval_mul_monomial f rho mq q;
  f.mul_zero (eval_monomial f rho mp);
  f.mul_zero (eval_monomial f rho mq);
  f.mul_zero cp;
  f.mul_zero (f.neg cq);
  f.add_zero f.zero

(* ----------------------------------------------------------------- *)
(* Ideal-membership certificates and completion                      *)
(* ----------------------------------------------------------------- *)

noeq type certificate (a:Type) =
  | Input: index:nat -> certificate a
  | Multiply: coefficient:a -> factor:monomial -> child:certificate a ->
              certificate a
  | Add: left:certificate a -> right:certificate a -> certificate a

let rec eval_certificate (#a:eqtype) (f:finite_field a) (rho:env a)
    (inputs:list (polynomial a)) (cert:certificate a)
  : Tot a (decreases cert)
= match cert with
   | Input i ->
     (match nth inputs i with
      | None -> f.zero
      | Some p -> eval_poly f rho p)
   | Multiply c m child ->
     f.mul c (f.mul (eval_monomial f rho m)
                    (eval_certificate f rho inputs child))
   | Add left right ->
     f.add (eval_certificate f rho inputs left)
           (eval_certificate f rho inputs right)

let all_zero (#a:eqtype) (f:finite_field a) (rho:env a)
    (inputs:list (polynomial a)) : prop
= forall p. mem p inputs ==> eval_poly f rho p == f.zero

let rec lemma_nth_mem (#a:eqtype) (xs:list a) (i:nat) (x:a)
  : Lemma (requires nth xs i == Some x)
          (ensures mem x xs)
          (decreases xs)
= match xs with
   | [] -> ()
   | y :: tl ->
     if i = 0 then ()
     else lemma_nth_mem tl (i - 1) x

let rec lemma_certificate_sound (#a:eqtype) (f:finite_field a) (rho:env a)
    (inputs:list (polynomial a)) (cert:certificate a)
  : Lemma (requires all_zero f rho inputs)
          (ensures eval_certificate f rho inputs cert == f.zero)
          (decreases cert)
= match cert with
   | Input i ->
     (match nth inputs i with
      | None -> ()
      | Some p -> lemma_nth_mem inputs i p)
   | Multiply c m child ->
     lemma_certificate_sound f rho inputs child;
     f.mul_zero (eval_monomial f rho m);
     f.mul_zero c
   | Add left right ->
     lemma_certificate_sound f rho inputs left;
     lemma_certificate_sound f rho inputs right;
     f.add_zero f.zero

let unsat_system (#a:eqtype) (f:finite_field a)
    (inputs:list (polynomial a)) : prop
= forall rho. ~(all_zero f rho inputs)

(* The checker accepts a certificate only when replay yields the constant
   one.  Since every input zero makes every ideal combination zero and
   zero<>one, the original equations are unsatisfiable. *)
let lemma_unit_ideal_unsat (#a:eqtype) (f:finite_field a)
    (inputs:list (polynomial a)) (cert:certificate a)
  : Lemma (requires (forall rho.
                      eval_certificate f rho inputs cert == f.one) /\
                    f.zero <> f.one)
          (ensures unsat_system f inputs)
= let witness (rho:env a) : Lemma (~(all_zero f rho inputs)) =
     if all_zero f rho inputs
     then lemma_certificate_sound f rho inputs cert
     else ()
   in
   FStar.Classical.forall_intro witness

(* Rabinowitsch completion used for disequalities:
       g != 0  iff  exists t. g*t - 1 = 0.
   The fresh variable is local to the completed polynomial system. *)
let lemma_rabinowitsch (#a:eqtype) (f:finite_field a) (g:a)
  : Lemma ((g <> f.zero) <==>
           (exists t. sub f (f.mul g t) f.one == f.zero))
= if g == f.zero
   then (
     let no_witness (t:a) : Lemma
       (~(sub f (f.mul g t) f.one == f.zero))
       = lemma_mul_zero_left f t;
         lemma_sub_eq_zero f f.zero f.one;
         f.zero_ne_one ()
     in
     FStar.Classical.forall_intro no_witness
   )
   else (
     f.inv_nonzero g;
     lemma_sub_eq_zero f (f.mul g (f.inv g)) f.one;
     FStar.Classical.exists_intro
       (fun t -> sub f (f.mul g t) f.one == f.zero)
       (f.inv g)
   )

(* Every element of F_q satisfies X^q-X.  Adding these equations therefore
   preserves exactly the base-field models while making finite projections
   explicit to Buchberger/F4 completion. *)
let lemma_field_equation (#a:eqtype) (f:finite_field a) (x:a)
  : Lemma (sub f (pow f x f.cardinality) x == f.zero)
= f.frobenius x;
  lemma_sub_self f x

let rec any_root (#a:eqtype) (q:a -> a) (zero:a) (roots:list a) : Tot bool
  (decreases roots)
= match roots with
   | [] -> false
   | x :: tl -> q x = zero || any_root q zero tl

let rec lemma_any_root_sound (#a:eqtype) (q:a -> a) (zero:a) (roots:list a)
  : Lemma (any_root q zero roots ==>
           (exists x. mem x roots /\ q x == zero))
          (decreases roots)
= match roots with
   | [] -> ()
   | x :: tl ->
     if q x == zero
     then FStar.Classical.exists_intro
            (fun y -> mem y roots /\ q y == zero) x
     else lemma_any_root_sound q zero tl

let rec lemma_any_root_complete (#a:eqtype) (q:a -> a) (zero:a)
    (roots:list a) (x:a)
  : Lemma (requires mem x roots /\ q x == zero)
          (ensures any_root q zero roots)
          (decreases roots)
= match roots with
   | [] -> ()
   | y :: tl ->
     if x == y then ()
     else lemma_any_root_complete q zero tl x

let lemma_root_split_complete (#a:eqtype) (f:finite_field a)
    (q:a -> a) (roots:list a) (x:a)
  : Lemma (requires (forall y. q y == f.zero <==> mem y roots))
          (ensures q x == f.zero ==> any_root q f.zero roots)
= if q x == f.zero
   then lemma_any_root_complete q f.zero roots x
   else ()

(* A complete enumeration is the semantic basis of ff_tiny and of bounded
   value/root splitting.  If a predicate is false on `values`, it is false
   everywhere because `values_complete` covers every field element. *)
let lemma_complete_enumeration (#a:eqtype) (f:finite_field a) (p:a -> bool)
  : Lemma (requires (forall x. mem x f.values ==> p x == false))
          (ensures forall x. p x == false)
= let each (x:a) : Lemma (p x == false) =
     f.values_complete x
   in
   FStar.Classical.forall_intro each

(* ----------------------------------------------------------------- *)
(* Model validation and theory/tactic combination                    *)
(* ----------------------------------------------------------------- *)

type equation (a:Type) = polynomial a & polynomial a
type disequation (a:Type) = polynomial a & polynomial a

let equation_holds (#a:eqtype) (f:finite_field a) (rho:env a)
    (e:equation a) : bool
= eval_poly f rho (fst e) = eval_poly f rho (snd e)

let disequation_holds (#a:eqtype) (f:finite_field a) (rho:env a)
    (e:disequation a) : bool
= not (eval_poly f rho (fst e) = eval_poly f rho (snd e))

let rec all_equations_hold (#a:eqtype) (f:finite_field a) (rho:env a)
    (es:list (equation a)) : Tot bool
  (decreases es)
= match es with
   | [] -> true
   | e :: tl -> equation_holds f rho e && all_equations_hold f rho tl

let rec all_disequations_hold (#a:eqtype) (f:finite_field a) (rho:env a)
    (es:list (disequation a)) : Tot bool
  (decreases es)
= match es with
   | [] -> true
   | e :: tl -> disequation_holds f rho e && all_disequations_hold f rho tl

let is_model (#a:eqtype) (f:finite_field a) (rho:env a)
    (eqs:list (equation a)) (neqs:list (disequation a)) : bool
= all_equations_hold f rho eqs && all_disequations_hold f rho neqs

(* SAT is exposed only after re-evaluating every original equation and
   disequation.  Candidate-generation heuristics are intentionally absent
   from the premise. *)
let lemma_validated_candidate_is_model (#a:eqtype) (f:finite_field a)
    (rho:env a) (eqs:list (equation a)) (neqs:list (disequation a))
  : Lemma (requires all_equations_hold f rho eqs /\
                    all_disequations_hold f rho neqs)
          (ensures is_model f rho eqs neqs)
= ()

(* Shared terms are opaque variables to the algebraic solver.  Equality
   arrangements supplied by the SMT equality engine are ordinary equations,
   so adding a true arrangement preserves a combined model. *)
let lemma_arrangement_preserves_model (#a:eqtype) (f:finite_field a)
    (rho:env a) (eqs:list (equation a)) (neqs:list (disequation a))
    (left right:polynomial a)
  : Lemma (requires is_model f rho eqs neqs /\
                    eval_poly f rho left == eval_poly f rho right)
          (ensures is_model f rho ((left, right) :: eqs) neqs)
= ()

(* The exact BV bridge uses a canonical integer in [0,p-1] for every field
   value.  Injectivity of that representation is the only semantic fact
   needed to transfer equality in either direction. *)
let lemma_canonical_encoding_equality (#a:eqtype) (encode:a -> nat) (x y:a)
  : Lemma (requires (forall u v. encode u == encode v ==> u == v))
          (ensures ((encode x == encode y) <==> (x == y)))
= ()
