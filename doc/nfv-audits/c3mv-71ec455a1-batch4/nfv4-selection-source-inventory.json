      "entry_source": [
        {
          "line": 824,
          "text": "        void cache_insert(node const& n) {"
        },
        {
          "line": 825,
          "text": "            if (!m_unsat_cache_enabled || !cache_eligible(n))"
        },
        {
          "line": 826,
          "text": "                return;"
        },
        {
          "line": 827,
          "text": "            vector<constraint_i const*> cs = compute_constraints(n);"
        },
        {
          "line": 828,
          "text": "            if (cs.empty())"
        },
        {
          "line": 829,
          "text": "                return;"
        },
        {
          "line": 830,
          "text": "            // Narrow the over-approximate active set down to just the"
        },
        {
          "line": 831,
          "text": "            // facts that could have contributed to THIS conflict (see"
        },
        {
          "line": 832,
          "text": "            // filter_by_conflict_dep()'s comment) before interning"
        },
        {
          "line": 833,
          "text": "            // anything: a smaller recorded core matches (as a subset)"
        },
        {
          "line": 834,
          "text": "            // more future nodes, so this only ever helps the cache's hit"
        },
        {
          "line": 835,
          "text": "            // rate, never hurts its soundness."
        },
        {
          "line": 836,
          "text": "            filter_by_conflict_dep(cs, n.conflict_dep());"
        },
        {
          "line": 837,
          "text": "            if (cs.empty())"
        },
        {
          "line": 838,
          "text": "                return;"
        },
        {
          "line": 839,
          "text": "            vector<unsigned> ids;"
        },
        {
          "line": 840,
          "text": "            for (constraint_i const* c : cs)"
        },
        {
          "line": 841,
          "text": "                ids.push_back(m_constraint_store.intern(*c));"
        },
        {
          "line": 842,
          "text": "            unsigned idx = m_unsat_cores.size();"
        },
        {
          "line": 843,
          "text": "            unsigned watch_id = ids[0];"
        },
        {
          "line": 844,
          "text": "            m_unsat_cores.push_back({ std::move(ids), 0 });"
        },
        {
          "line": 845,
          "text": "            watch(watch_id, idx);"
        },
        {
          "line": 846,
          "text": "        }"
        }
      ]
    },
