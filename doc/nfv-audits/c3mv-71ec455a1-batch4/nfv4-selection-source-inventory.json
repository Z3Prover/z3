          "line": 601,
          "text": "            unsigned intern(constraint_i const& c) {"
        },
        {
          "line": 602,
          "text": "                unsigned id;"
        },
        {
          "line": 603,
          "text": "                if (find(c, id))"
        },
        {
          "line": 604,
          "text": "                    return id;"
        },
        {
          "line": 605,
          "text": "                constraint_i* owned = c.clone();"
        },
        {
          "line": 606,
          "text": "                id = m_owned.size();"
        },
        {
          "line": 607,
          "text": "                owned->set_store_id(id);"
        },
        {
          "line": 608,
          "text": "                m_owned.push_back(owned);"
        },
        {
          "line": 609,
          "text": "                m_ids.insert(owned);"
        },
        {
          "line": 610,
          "text": "                return id;"
        },
        {
          "line": 611,
          "text": "            }"
        }
      ]
