        {
          "line": 43,
          "text": "    void power_facet::apply_subst(expr* var, expr_ref_vector const& repl, eq_tree::dep_tracker) {"
        },
        {
          "line": 44,
          "text": "        unsigned idx;"
        },
        {
          "line": 45,
          "text": "        if (find_power(var, idx))"
        },
        {
          "line": 46,
          "text": "            remove(idx);"
        },
        {
          "line": 47,
          "text": "        for (expr* t : repl)"
        },
        {
          "line": 48,
          "text": "            add_power_if(t);"
        },
        {
          "line": 49,
          "text": "        // rebase obligations whose base mentions var; the power token keeps its identity"
        },
        {
          "line": 50,
          "text": "        for (unsigned i = 0; i < m_pows.size(); ++i) {"
        },
        {
          "line": 51,
          "text": "            if (!m_pows[i].active())"
        },
        {
          "line": 52,
          "text": "                continue;"
        },
        {
          "line": 53,
          "text": "            expr_ref_vector base(m);"
        },
        {
          "line": 54,
          "text": "            u.str.get_concat_units(m_pows[i].m_s.get(), base);"
        },
        {
          "line": 55,
          "text": "            if (!base.contains(var))"
        },
        {
          "line": 56,
          "text": "                continue;"
        },
        {
          "line": 57,
          "text": "            subst_in(base, var, repl);"
        },
        {
          "line": 58,
          "text": "            m_trail.push(vector_field_trail<str_power, expr_ref>(m_pows, i, &str_power::m_s));"
        },
        {
          "line": 59,
          "text": "            m_pows[i].m_s = u.str.mk_concat(base, m_pows[i].m_e->get_sort());"
        },
        {
          "line": 60,
          "text": "        }"
        },
        {
          "line": 61,
          "text": "    }"
        }
      ]
    },
