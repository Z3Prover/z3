def_module_params('tptp',
                  description='TPTP frontend parameters',
                  class_name='tptp',
                  export=True,
                  params=(('root', SYMBOL, '', 'root directory for resolving TPTP include() axiom paths (replaces the TPTP environment variable)'),
                          ('dump_smt2', SYMBOL, '', 'if non-empty, file path to dump the parsed TPTP goal as an SMT-LIB2 benchmark (replaces the Z3_TPTP_DUMP_SMT2 environment variable)'),
                          ('unfold_lambda_macros', BOOL, True, 'pre-process the goal by unfolding constants that are defined as lambda terms (shallow embeddings of higher-order/modal operators), inlining and beta-reducing their occurrences'),
                          ('reify_lambda_literals', BOOL, False, 'pre-process the goal by reifying lambda literals occurring as subterms into fresh named constants with a defining select-equality axiom, so they participate in ordinary E-matching (experimental: helps predicate lambdas with existentially-quantified bodies passed as arguments, but can regress problems where matching already succeeds directly against a lambda-shaped argument, e.g. modal mbox/mforall-style shallow embeddings)'),
                          ('leibniz_instantiation', BOOL, False, 'pre-process the goal by synthesizing and adding Leibniz-equality style instantiations of universally quantified predicate variables applied to distinct argument terms'),
                          ('witness_instantiation', BOOL, False, 'pre-process the goal by instantiating universally quantified assertions over uninterpreted sorts that have no ground witness term anywhere in the problem, using a fresh synthesized witness constant, so that the instantiated fact can seed further E-matching')))
