load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE.txt",
)

exports_files(["LICENSE.txt"])

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

# The full version that CMake reads from scripts/VERSION.txt.
# Kept in sync by scripts/update_version.py; do not edit by hand.
_Z3_VERSION = "5.3.4.0"

# Matches SOVERSION in src/CMakeLists.txt (major.minor).
_Z3_SOVERSION = ".".join(_Z3_VERSION.split(".")[:2])

# rules_foreign_cc declares these names verbatim, so spell out the .exe suffix.
_Z3_BINARIES = select({
    "@platforms//os:windows": ["z3.exe"],
    "//conditions:default": ["z3"],
})

_DEFAULT_CMAKE_GENERATE_ARGS = [
    "-G Ninja",
    "-D CMAKE_INSTALL_LIBDIR=lib",  # Matches rules_foreign_cc's default out_lib_dir.
]

cmake(
    name = "z3_dynamic",
    generate_args = _DEFAULT_CMAKE_GENERATE_ARGS + [
        "-D Z3_EXPORTED_TARGETS=",  # prevents installation, leaving symlinks between dylibs intact on copy
    ],
    lib_source = ":all_files",
    out_binaries = _Z3_BINARIES,
    out_shared_libs = select({
        "@platforms//os:linux": [
            "libz3.so",
            "libz3.so." + _Z3_SOVERSION,
            "libz3.so." + _Z3_VERSION,
        ],
        "@platforms//os:osx": [
            "libz3.dylib",
            "libz3.%s.dylib" % _Z3_SOVERSION,
            "libz3.%s.dylib" % _Z3_VERSION,
        ],
        "@platforms//os:windows": ["libz3.dll"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

cmake(
    name = "z3_static",
    generate_args = _DEFAULT_CMAKE_GENERATE_ARGS + [
        "-D BUILD_SHARED_LIBS=OFF",
    ],
    lib_source = ":all_files",
    out_binaries = _Z3_BINARIES,
    out_static_libs = select({
        "@platforms//os:linux": ["libz3.a"],
        "@platforms//os:osx": ["libz3.a"],
        # src/CMakeLists.txt renames the static MSVC archive so it can sit next to
        # the shared build's libz3.lib import library.
        "@platforms//os:windows": ["libz3-static.lib"],  # MSVC with Control Flow Guard enabled by default
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "z3",
    actual = ":z3_dynamic",
    visibility = ["//visibility:public"],
)
